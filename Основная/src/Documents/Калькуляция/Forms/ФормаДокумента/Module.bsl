&НаКлиенте
Процедура ОткрытьВыборМатериала(Элемент, СтандартнаяОбработка)
    СтрокаЗапчасти = Элементы.Запчасти.ТекущиеДанные;
    Если СтрокаЗапчасти = Неопределено Тогда
        СтандартнаяОбработка = Ложь;
        Возврат;
    КонецЕсли;

    СтандартнаяОбработка = Ложь;

    Данные = ПолучитьДанныеДляОтбора(Объект.Автомобиль, СтрокаЗапчасти.АвтоДеталь);

    ПараметрыФормы = Новый Структура("АвтоДеталь, МаркаАвто, МодельАвто",
        Данные.АвтоДеталь,
        Данные.МаркаАвто,
        Данные.МодельАвто);

    ОткрытьФорму("Справочник.Материалы.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьДанныеДляОтбора(Автомобиль, АвтоДеталь)
    Данные = Новый Структура("МаркаАвто, МодельАвто, АвтоДеталь");

    Если ЗначениеЗаполнено(Автомобиль) Тогда
        Данные.МаркаАвто  = Автомобиль.Марка;
        Данные.МодельАвто = Автомобиль.Модель;
    Иначе
        Данные.МаркаАвто  = Неопределено;
        Данные.МодельАвто = Неопределено;
    КонецЕсли;

    Данные.АвтоДеталь = АвтоДеталь;
    Возврат Данные;
КонецФункции

&НаКлиенте
Процедура ЗапчастиАвтоДетальНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
		СтрокаРаботы = Элементы.Работы.ТекущиеДанные;
    Если СтрокаРаботы = Неопределено Тогда
        СтандартнаяОбработка = Ложь;
        ПоказатьПредупреждение(, "Сначала выберите работу в списке работ.");
        Возврат;
    КонецЕсли;
    СтандартнаяОбработка = Ложь;
    ПараметрыФормы = Новый Структура("Работа", СтрокаРаботы.НаименованиеРаботы);
    ОткрытьФорму("Справочник.АвтоДетали.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры