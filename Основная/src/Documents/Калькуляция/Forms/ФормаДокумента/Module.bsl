
&НаКлиенте
Процедура ЗапчастиКоличествоПриИзменении(Элемент)
	Строка = Элементы.Запчасти.ТекущиеДанные;
    
    Если Строка = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Строка.Сумма1 = Строка.Цена1 * Строка.Количество;
    Строка.Сумма2 = Строка.Цена2 * Строка.Количество;
    Строка.Сумма3 = Строка.Цена3 * Строка.Количество;
КонецПроцедуры


