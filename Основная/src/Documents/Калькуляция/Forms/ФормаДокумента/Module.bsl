&НаКлиенте
Процедура ЗаполнитьЦенуВарианта(НомерВарианта)
    Строка = Элементы.Запчасти.ТекущиеДанные;
    Если Строка = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Материал = ?(НомерВарианта = 1, Строка.Вариант1,
              ?(НомерВарианта = 2, Строка.Вариант2, Строка.Вариант3));

    Цена = ПолучитьЦенуМатериала(Материал, Объект.Дата);

    Если НомерВарианта = 1 Тогда
        Строка.Цена1 = Цена;
        Строка.Сумма1 = Цена * Строка.Количество;
    ИначеЕсли НомерВарианта = 2 Тогда
        Строка.Цена2 = Цена;
        Строка.Сумма2 = Цена * Строка.Количество;
    Иначе
        Строка.Цена3 = Цена;
        Строка.Сумма3 = Цена * Строка.Количество;
    КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦенуМатериала(Материал, ДатаДокумента)
    Если НЕ ЗначениеЗаполнено(Материал) Тогда
        Возврат 0;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |   СрезПоследних.Стоимость КАК Стоимость
        |ИЗ
        |   РегистрСведений.СтоимостьМатериалов.СрезПоследних(&Дата, Материал = &Материал) КАК СрезПоследних";
    Запрос.УстановитьПараметр("Дата",  ДатаДокумента);
    Запрос.УстановитьПараметр("Материал", Материал);

    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Стоимость;
    Иначе
        Сообщить("Для материала """ + Материал + """ не задана стоимость!");
        Возврат 0;
    КонецЕсли;
КонецФункции


